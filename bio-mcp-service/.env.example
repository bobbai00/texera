# bio-mcp-service webserver configuration
PORT=3010
MCP_PATH=/mcp

# Optional API key required by agent-service when set.
BIOMCP_API_KEY=

# External biomedical source keys. Leave blank to disable tools that require them.
OMIM_API_KEY=

# Optional placeholder-backed tools.
ENABLE_PLACEHOLDER_TOOLS=false
ENABLE_OMIM_PLACEHOLDER=false
ENABLE_BLAST_PLACEHOLDER=false
