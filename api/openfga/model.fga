model
  schema 1.1

# Texera 2.0 authorization model, version 3.
#
# Every catalog resource is a `resource` object whose id is its rid. Grants are the four
# relations owner, editor, viewer and user; `parent` carries them down the tree (project to
# workflow to execution). On a project, an owner is one of its admins and an editor a member.
#
# A project inherits from one other, its base: the base names the project an `inheritor`, and
# the people who may view or use the inheritor may view or use what the base holds. Only viewing
# and using pass up a chain, never editing or owning, and nothing passes down it: a base's
# admins get nothing in the projects that inherit from it. Texera, the root of every chain, is
# open to everyone instead (`viewer` and `user` granted to `user:*`), so a link to it needs no
# tuple.
#
# Viewing never implies using: a viewer of a project reads and runs what is in it but cannot
# lease its credentials. Permissions are the computed relations the catalog checks (`can_*`);
# the REST operations map to them through x-texera-permission. `type agent` is reserved for
# agents with identities of their own; in the current design agents act as the person.

type user

type agent
  relations
    define sponsor: [user]

type group
  relations
    define member: [user, agent, group#member]

type resource
  relations
    define parent: [resource]
    # inheritor: on a project, a project that inherits from it.
    define inheritor: [resource]

    define owner: [user, agent, group#member] or owner from parent
    define editor: [user, agent, group#member] or owner or editor from parent
    define viewer: [user, agent, group#member, user:*] or editor or viewer from parent or viewer from inheritor
    # user: may run on a computing unit, keep results in a warehouse or lease a credential
    # without reading its spec; granted explicitly, held by editors, inherited from the parent
    # or from the projects that inherit. Never implied by viewer.
    define user: [user, agent, group#member, user:*] or editor or user from parent or user from inheritor

    define can_read: viewer
    define can_write: editor
    define can_share: owner
    define can_delete: owner
    # admin: change a project itself, its settings, what it inherits from and its people.
    define can_admin: owner
    # execute: run a workflow; viewers may run what they can read.
    define can_execute: viewer
    # use: lease a credential (the key behind a model endpoint or an MCP server header), or
    # keep an execution's results in a warehouse.
    define can_use: user
    # run_on: start an execution on a computing unit.
    define can_run_on: user
    # rotate: write a credential's secret.
    define can_rotate: editor
