# Envoy for the Docker Compose and local-dev modes (plain Envoy, static config).
# run.sh renders this file, replacing __AUTHZ_HOST__ and __AUTHZ_PORT__ with the
# address of the authorization stub (the Dashboard service in the real deployment).
#
# What a request for a unit goes through, in filter order:
#   1. early header mutation: drop any client-supplied unit key, unit address or user
#      header, before anything reads them;
#   2. ext_authz (HTTP): ask the stub with the same method, path + query and the login;
#      a non-200 answer goes back to the client and no unit is contacted;
#      a 200 answer's Host, X-Texera-Unit-Key and X-Texera-User replace the request's;
#   3. dynamic forward proxy: resolve the (now rewritten) Host by DNS and pick that
#      host:port as the upstream. Envoy Gateway's DynamicResolver Backend is the same
#      cluster type; it leaves out this filter and lets the cluster resolve on first use.
#      The route is not recomputed after the check (no clear_route_cache): the route and
#      cluster stay the same, only the host the cluster connects to changes;
#   4. router: the route strips Authorization and Cookie, so the unit never sees the login.
admin:
  address:
    socket_address: { address: 0.0.0.0, port_value: 9901 }

static_resources:
  listeners:
  - name: gateway
    address:
      socket_address: { address: 0.0.0.0, port_value: 10080 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: gateway
          # Same path handling Envoy Gateway applies by default: resolve dot segments and
          # merge slashes before ext_authz sees the path; redirect on encoded slashes.
          normalize_path: true
          merge_slashes: true
          path_with_escaped_slashes_action: UNESCAPE_AND_REDIRECT
          # Also an Envoy Gateway default: x_texera_unit_key must not slip past the header
          # removal below and reach a unit framework that treats "_" like "-".
          common_http_protocol_options:
            headers_with_underscores_action: REJECT_REQUEST
          upgrade_configs:
          - upgrade_type: websocket
          early_header_mutation_extensions:
          - name: envoy.http.early_header_mutation.header_mutation
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.http.early_header_mutation.header_mutation.v3.HeaderMutation
              mutations:
              - remove: x-texera-unit-key
              - remove: x-texera-unit-address
              - remove: x-texera-user
          route_config:
            name: gateway
            virtual_hosts:
            - name: units
              domains: ["*"]
              routes:
              - match: { prefix: "/api/units/" }
                route:
                  cluster: units_dynamic
                  timeout: 0s             # a result export may stream for longer than 15s
                request_headers_to_remove: [authorization, cookie]
              - match: { prefix: "/wsapi/units/" }
                route:
                  cluster: units_dynamic
                  timeout: 0s
                request_headers_to_remove: [authorization, cookie]
          http_filters:
          - name: envoy.filters.http.ext_authz
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz
              transport_api_version: V3
              failure_mode_allow: false
              http_service:
                server_uri:
                  uri: http://__AUTHZ_HOST__:__AUTHZ_PORT__
                  cluster: authz
                  timeout: 2s
                path_prefix: /authz
                authorization_request:
                  # Sent to the check besides the defaults (Host, Method, Path, Content-Length,
                  # Authorization): a browser WebSocket can carry the login only in a cookie.
                  allowed_headers:
                    patterns:
                    - { exact: cookie, ignore_case: true }
                authorization_response:
                  # Headers of a 200 answer that replace the request's before it goes upstream.
                  allowed_upstream_headers:
                    patterns:
                    - { exact: host, ignore_case: true }
                    - { exact: x-texera-unit-key, ignore_case: true }
                    - { exact: x-texera-user, ignore_case: true }
          - name: envoy.filters.http.dynamic_forward_proxy
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig
              dns_cache_config:
                name: units_dns_cache
                dns_lookup_family: V4_ONLY
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
  - name: units_dynamic
    connect_timeout: 2s
    lb_policy: CLUSTER_PROVIDED
    cluster_type:
      name: envoy.clusters.dynamic_forward_proxy
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
        dns_cache_config:
          name: units_dns_cache
          dns_lookup_family: V4_ONLY
  - name: authz
    type: STRICT_DNS
    connect_timeout: 1s
    dns_lookup_family: V4_ONLY
    load_assignment:
      cluster_name: authz
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: __AUTHZ_HOST__, port_value: __AUTHZ_PORT__ }
