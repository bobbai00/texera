{
  "name": "frontend-react",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook",
    "test:e2e": "yarn build && playwright test",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "shared-editing": "tsx shared-editing-service/main.ts",
    "build:shared-editing": "vite build --config shared-editing-service/vite.config.ts",
    "stack:up": "cd .. && docker compose -f bin/single-node/docker-compose.yml -f frontend-react/e2e/stack/compose.yml up -d --wait postgres rustfs lakefs file-service config-service dashboard-service shared-editing-service nginx",
    "stack:down": "cd .. && docker compose -f bin/single-node/docker-compose.yml -f frontend-react/e2e/stack/compose.yml down -v"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lsp-client": "6.3.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hocuspocus/provider": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-core": "1.171.39",
    "@xyflow/react": "12.12.0",
    "ajv": "8.18.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "codemirror": "6.0.2",
    "fast-json-patch": "3.1.1",
    "lucide-react": "1.72.0",
    "papaparse": "5.7.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "read-excel-file": "5.8.8",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
