{
  "name": "@texera/catalog-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript client for the Texera catalog API (types, fetch client, TanStack Query options, Zod schemas)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./query": "./src/gen/@tanstack/react-query.gen.ts",
    "./zod": "./src/gen/zod.gen.ts",
    "./types": "./src/gen/types.gen.ts"
  },
  "scripts": {
    "generate": "openapi-ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "@tanstack/react-query": "5.104.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  }
}
