    "@texera/workflow-model": "workspace:*",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@hocuspocus/provider": "4.8.0",
    "@types/node": "24.10.1",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
