{
  "name": "@texera/live",
  "version": "0.1.0",
  "private": true,
  "description": "Texera 2.0 live service: the sessions in which people are on a resource together. Presence for every resource; for a workflow, the document they edit at once, saved into the catalog's versions.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
